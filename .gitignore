# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# uv-managed virtualenv (uv.lock IS committed)
.venv/

# Host configuration, read by lockin.config.load_env_file. Never committed: it
# names this host's database, and may carry LOCKIN_NTFY_TOPIC — ntfy topics are
# unauthenticated, so the topic name is the whole of the secret.
.env

# Local data — regenerable via `lockin ingest`
*.db
*.db-wal
*.db-shm
data/
logs/

# Rendered output — regenerable via `lockin dashboard` / `lockin advice`, and it
# embeds the league's manager names and your lineup, which do not belong in the repo.
dashboard.html
advice.html

# Claude Code local settings and harness temp files
.claude/settings.local.json
.claude/*.tmp.*
